    "commander": "^15.1.0",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.12.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
