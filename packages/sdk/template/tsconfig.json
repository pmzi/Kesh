{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@kesh/sdk": ["./types/kesh-sdk.d.ts"],
      "react": ["./types/react.d.ts"],
      "react-native": ["./types/react-native.d.ts"]
    }
  },
  "include": ["plugins/**/*", "types/**/*"]
}
